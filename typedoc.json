{
  "entryPoints": ["./src/**/*.ts"], // Or ["./src/**/*.ts"] for multiple files
  "out": "docs", // Output directory for documentation
  "name": "Admin Frontend Angular Docs", // Name of your project
  "excludePrivate": true, // Exclude members marked as private
  "excludeProtected": true, // Exclude members marked as protected
  "excludeInternal": true, // Exclude members marked with @internal JSDoc tag
  "hideGenerator": false, // Show "Generated by TypeDoc" footer
  "includeVersion": true, // Include package version in documentation
  "tsconfig": "./tsconfig.json", // Path to your tsconfig.json (important for TypeScript projects)
  "entryPointStrategy": "resolve", // Or "packages" for monorepos, "modules" etc.
  "readme": "README.md", // Path to your README file to include
  "exclude": ["./src/**/*.spec.ts"]
  // "theme": "default"               // You can specify a custom theme here
}
